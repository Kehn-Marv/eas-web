APP_NAME=EAS API
ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./eas-dev-v10.db
SQL_ECHO=false
STORAGE_BACKEND=filesystem
STORAGE_ROOT=./private-objects
S3_BUCKET=
AWS_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=500
MAX_QUEUED_JOBS=500
MAX_RUNNING_JOBS=4
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
EXTRACTION_MIN_CHARS=40
OCR_LANGUAGE=eng
PARSER_BACKEND=pymupdf
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=eas-vision
VISION_TIMEOUT_SECONDS=60
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=eas-chat
LLM_TIMEOUT_SECONDS=60
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=eas-api
ADAPTIVE_LOW_THRESHOLD=0.25
ADAPTIVE_MEDIUM_THRESHOLD=0.45
ADAPTIVE_HIGH_THRESHOLD=0.70
ADAPTIVE_COOLDOWN_TURNS=2
ADAPTIVE_HYSTERESIS=0.08
