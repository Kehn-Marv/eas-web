# Dependencies and build output are installed/built inside the image.
**/node_modules
**/.next
**/.next-*
**/dist
**/out
**/.turbo
**/.vercel

# Runtime state is mounted as a volume and must never be copied into an image.
data
data-eas-local
**/data-eas-local
**/data-eas-local/**
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*

# Local secrets, settings, and caches must not enter the remote build context.
.env
.env.*
**/.env
**/.env.*
.cache
**/.cache

# Local development metadata and caches.
.git
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.venv
**/venv
**/env
