# ============================================
# EAS Root .gitignore
# ============================================

# ============================================
# Runtime Data & User Storage
# ============================================
data/
**/data/
data-eas-local/
**/data-eas-local/
multi-user/
**/multi-user/
apps/eas/docs/
design-qa.md
site/
.claude/
.agents/
.workbuddy/
.gemini/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.pdf
!apps/eas/tests/fixtures/lightrag_bridge/original.pdf
!apps/eas/tests/fixtures/lightrag_bridge/mineru-v2-current/*_origin.pdf

# ============================================
# Python Related
# ============================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
env/
venv/
ENV/
.venv/
**/env/
**/venv/
**/.venv/
env.bak/
venv.bak/

# Environment configuration & Secrets (Keep example templates only)
.env
.env.*
*.env
*.env.local
.env.local
.env.production
.env.development
!.env.example
!**/.env.example

# ============================================
# Node.js and Frontend Build
# ============================================
node_modules/
**/node_modules/
pnpm-lock.yaml
pnpm-workspace.yaml

# Next.js build output
.next/
**/.next/
web/.next-*/
apps/eas/web/.next-*/
