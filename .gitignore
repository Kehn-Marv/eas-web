apps/eas/web/public/pdfjs/
web/tsconfig.eas-*.json
apps/eas/web/tsconfig.eas-*.json
web/tmp/
apps/eas/web/tmp/
out/
.vercel/
.turbo/
.open-next/
.wrangler/
.vite/

# TypeScript build info
*.tsbuildinfo

# Common Output and Cache Directories
output/
outputs/
cache/
.cache/
.ruff_cache/
.import_linter_cache/
.playwright-cli/
web/test-results/
web/playwright-report/
apps/eas/web/test-results/
apps/eas/web/playwright-report/

# Log files
*.log
*.log.*
*.jsonl
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

